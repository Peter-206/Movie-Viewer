# Keep this movie drive private by default. Only project files are allowed below.
/*
!/.gitignore
!/README.md
!/future implementaions/
/future implementaions/*
!/future implementaions/*.md

# Reject media, local catalogs, and generated files inside allowed directories too.
*.mkv
*.mp4
*.avi
*.mov
*.m4v
*.wmv
*.webm
*.mpg
*.mpeg
*.ts
*.m2ts
*.vob
*.iso
*.jpg
*.jpeg
*.png
*.webp
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3
*.exe
*.pyc
__pycache__/

# Allow only Movie Shelf source, instructions, and manifests.
/.playback/**
!/.playback/
!/.playback/README.md
!/.playback/build-release.ps1
!/.playback/server/
!/.playback/server/Cargo.toml
!/.playback/server/Cargo.lock
!/.playback/server/src/
!/.playback/server/src/*.rs
!/.playback/player/
!/.playback/player/package*.json
!/.playback/player/*.cjs
!/.playback/player/*.js
!/.playback/player/*.html
!/.playback/player/*.css
!/.playback/verification/
!/.playback/verification/*.ps1
!/.playback/verification/*.md
!/.playback/verification/*.cjs
!/.playback/verification/.gitignore
!/.playback/player/README.md
!/.playback/server/README.md
